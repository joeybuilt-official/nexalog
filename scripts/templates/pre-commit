#!/usr/bin/env sh
# Starter local pre-commit gate. Copy to .git/hooks/pre-commit (chmod +x), or wire it via husky /
# lefthook / pre-commit. Nexalog has no hook manager today, so nothing runs this until you install it.
#
# HONEST NOTE: a client-side hook is convenience, not enforcement — any agent can bypass it with
# `git commit --no-verify`, and a non-Claude agent may not run it at all. The binding plane is
# required CI (`.github/workflows/verify.yml`, which is wired and is a required check on `main`).
# This hook just catches a problem a few seconds earlier for whoever keeps it installed.
#
# Commands below match AGENTS.md → Commands and nexalog's real package.json scripts.
set -eu

echo "pre-commit: typecheck…"; pnpm typecheck
echo "pre-commit: lint…";      pnpm lint
echo "pre-commit: test…";      pnpm test

# Architecture boundaries — WIRED 2026-09-25: `.dependency-cruiser.cjs` + the `depcruise` script
# exist now, so this runs (a layering breach fails the commit, same rules CI enforces).
echo "pre-commit: architecture boundaries…"; pnpm depcruise

# Keep the tool-native agent mirrors in sync with AGENTS.md (fails if a mirror drifted).
if [ -f scripts/sync-agents.sh ]; then
  echo "pre-commit: agent mirrors…"; sh scripts/sync-agents.sh --check
fi

# Docs landing gate — no code change lands without its worklog line in the same commit.
# Nexalog's worklog target is docs/agents/worklog.md (no CHANGELOG.md/HISTORY.md here).
if [ -f scripts/check-docs.sh ]; then
  echo "pre-commit: docs gate…"; sh scripts/check-docs.sh
fi

# Plan-home gate — a plan doc may only live in the allowed home (a row in docs/agents/roadmap.md,
# depth at docs/agents/<area>/<slug>/plan.md). Wired 2026-09-30; also runs in required CI.
if [ -f scripts/check-plan-home.sh ]; then
  echo "pre-commit: plan home…"; sh scripts/check-plan-home.sh --staged
fi

# Expert-review gate — NOT wired, deliberately. The script is current and would pass, but enabling it
# adds a merge requirement for every future PR: an operator decision, not a side effect of a refresh.
# See `.github/workflows/verify.yml`'s header for the full note.
# if [ -f scripts/check-expert-review.sh ]; then
#   echo "pre-commit: expert review…"; sh scripts/check-expert-review.sh
# fi

echo "pre-commit: OK"
