{
  "name": "Nexalog",
  "short_name": "Nexalog",
  "description": "Your AI-enhanced personal knowledge base",
  "start_url": "/app/today",
  "display": "standalone",
  "background_color": "#09090b",
  "theme_color": "#09090b",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "/app/share",
    "method": "POST",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "shortcuts": [
    {
      "name": "Quick capture",
      "url": "/app/share",
      "description": "Capture a thought or URL"
    },
    {
      "name": "Today",
      "url": "/app/today",
      "description": "Open today's daily note"
    }
  ]
}
