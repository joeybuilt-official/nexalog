# Database — shared Postgres, nexalog schema
DATABASE_URL=postgresql://user:password@localhost:5432/appdb?options=-c%20search_path%3Dnexalog

# Better Auth
AUTH_SECRET=generate-a-random-secret-here
BETTER_AUTH_URL=https://mynexalog.com
# NEXALOG-HOSTSPLIT — the canonical FRONT-END origin (the marketing site and the
# login page). Leave it UNSET for a single-host deployment: with nothing here the
# host split stays off and every redirect behaves exactly as it did before.
# Set it (e.g. https://nexalog.com) alongside BETTER_AUTH_URL pointing at the app
# host (https://app.nexalog.com) to run the two-host split.
NEXALOG_FRONTEND_URL=
# Only needed when the app origin is NOT the Better Auth URL. BETTER_AUTH_URL wins
# by default; this is the escape hatch for a deployment where they must differ.
NEXALOG_APP_URL=
# Comma- or whitespace-separated LIST. Every entry is trusted; a single value
# behaves exactly as it always has.
TRUSTED_ORIGIN=

# Plexo
PLEXO_URL=http://localhost:3001
PLEXO_SERVICE_KEY=your-plexo-service-key

# ─────────────────────────────────────────────────────────────
# Intelligence — the embedded model leg behind
# `lib/intelligence` (ADR-0014/0017). Optional: with NOTHING set
# the app runs standalone and every model-backed surface degrades
# to its labelled un-enriched view (a project brief becomes a
# mechanical digest). Set BOTH the URL and the key to enable
# synthesis. The endpoint must be OpenAI-compatible; `/chat/
# completions` is appended to LLM_BASE_URL.
# ─────────────────────────────────────────────────────────────
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=auto

# ─────────────────────────────────────────────────────────────
# Video transcription — Phase 1 (Supadata, ADR-0007).
# Used by lib/transcription/* to fetch YouTube captions (with AI/ASR
# fallback) for video bookmarks. Routed direct as a content-source;
# moves behind a Plexo `transcription` verb when ADR-0006 ships.
# ─────────────────────────────────────────────────────────────
SUPADATA_API_KEY=
SUPADATA_BASE_URL=https://api.supadata.ai
TRANSCRIPT_MAX_DURATION_SECONDS=5400
TRANSCRIPT_ALLOW_ASR=true
TRANSCRIPT_BACKFILL_CREDIT_FLOOR=50

# ─────────────────────────────────────────────────────────────
# Payments (Joeybuilt Cloud only)
# Self-hosters can leave BILLING_ENABLED unset/false. When false,
# Stripe routes return 404 and the /app/billing page + super-admin
# coupon management are hidden. See README "Self-Hosting Notes".
# ─────────────────────────────────────────────────────────────
BILLING_ENABLED=false
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRO_PRICE_ID=
# NEXT_PUBLIC_APP_URL=

# Super-admin (optional — comma-separated emails granted admin UI access)
# SUPER_ADMIN_EMAILS=
