# Database — shared Postgres, nexalog schema
DATABASE_URL=postgresql://user:password@localhost:5432/appdb?options=-c%20search_path%3Dnexalog

# Better Auth
AUTH_SECRET=generate-a-random-secret-here
BETTER_AUTH_URL=https://mynexalog.com

# Plexo
PLEXO_URL=http://localhost:3001
PLEXO_SERVICE_KEY=your-plexo-service-key

# ─────────────────────────────────────────────────────────────
# Video transcription — Phase 1 (Supadata, ADR-0007).
# Used by lib/transcription/* to fetch YouTube captions (with AI/ASR
# fallback) for video bookmarks. Routed direct as a content-source;
# moves behind a Plexo `transcription` verb when ADR-0006 ships.
# ─────────────────────────────────────────────────────────────
SUPADATA_API_KEY=
SUPADATA_BASE_URL=https://api.supadata.ai
TRANSCRIPT_MAX_DURATION_SECONDS=5400
TRANSCRIPT_ALLOW_ASR=true
TRANSCRIPT_BACKFILL_CREDIT_FLOOR=50

# ─────────────────────────────────────────────────────────────
# Payments (Joeybuilt Cloud only)
# Self-hosters can leave BILLING_ENABLED unset/false. When false,
# Stripe routes return 404 and the /app/billing page + super-admin
# coupon management are hidden. See README "Self-Hosting Notes".
# ─────────────────────────────────────────────────────────────
BILLING_ENABLED=false
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRO_PRICE_ID=
# NEXT_PUBLIC_APP_URL=

# Super-admin (optional — comma-separated emails granted admin UI access)
# SUPER_ADMIN_EMAILS=
